[ T i t l e ]
Blanco: Película de 16 micrones de espesor de LiF. Fuente de protones de 6 MeV, prisma de base cuadrada de 0.2 cm de lado, 0.1 cm de espesor y unidireccional. 
Se calcula la corriente de partículas secundarias y de fotones que emergen del blanco. 
05/12/2025

[ P a r a m e t e r s ]
 icntl    =           0     # (D=0)  con un 8 genera el eps que permite ver la geometria, con 0 hay interacciones, con 5 ves la fuente sin interacciones
 maxcas   =          1e6    # (D=10) numero de particulas por batch
 maxbch   =          1e5    # (D=10) numero de batches
 #file(1)  = /mnt/Data/phits # (D=) nombre de la carpeta donde se encuentra instalado PHITS
 file(1)  = /home/eliana/phits # (D=) nombre de la carpeta donde se encuentra instalado PHITS
 file(6)  = phits_protones_LiF_productos_3.out       # (D=phits.out) general output file name
 nucdata  =     1           # 1: Use neutron nuclear data library from 0.1 meV to 20 MeV; 0 use neutron nuclear rection models  
 negs     =           1     # (D=0) Transport only photons; =1 EGS Transporte de e-, e+, y fotones EGS5 database
 emin(1)  =     1.0e-8      # (D=1e-3) energía de corte proton [MeV] 
 emin(2)  =     1.0e-11     # (D=1e-3) energía de corte neutron [MeV] esta es la mínima para transporte y generación de neutrones
 emin(14) =     1.0e-3      # (D=0.001 si negs=1) energía de corte fotones [MeV] esta es la mínima para transporte y generación
 dmax(2)  =     150.0       # for JENDL-HE (high-energy nuclear data library)
 dmax(1)  =     150.0       # for JENDL-HE (high-energy nuclear data library)
 dmax(14) =     1e3         # Upper energy limit of atomic library use for photons [MeV]
 #emin(12) =     1.0e-6      # (D=0.1 si negs=1) energía de corte e- [MeV] esta es la mínima para transporte y generación de e- y e+
 #emin(13) =     1.0e-6      # (D=0.1 si negs=1) energía de corte e+ [MeV]
 e-mode   =           2     # (D=0) D=0 Muestreo simple, D=1 + modelo de evaporación, D=2 + cosecha de partículas cargadas + distribución de En 
 ikerman  =           1     # (D=0) Kerma approximation for neutrons. D=0,1 it is not used, D=2 it is used.
 ipnint   =           1     # (D=0) 0: no, 1: consider photo-nuclear reaction
 itall    =           1     #  Actualizo resultados al finalizar cada lote (gráficos)
 kmout =              1     # se informa librerías usadas en file(6)
 isaba =              0     # interpolación de los datos de S(alfa,beta) que deberían ser calculados pero no lo son en blancos muy finos 
 ismm  =              1     # activa "multifragmentación estadística" para calcular la producción más precisa de residuos nucleares
 icxsni  =            0     # 0: Pearlstein-Niita’s formula; 1: KUROTAMA model; 2: Sato’s formula
 icrhi  =             2     # 0: Shen formula; 1: NASA formula; 2: KUROTAMA model   Options for total cross section of nucleus-nucleus collisions
 icxnp  =             1     # 0: Original database included in JAM; 1: Data included in JENDL/HE-2007
 #istdev   = -1             #  restart calculation mode (para continuar simulacion)

set: c1[0.0016]           $ espesor del blanco en z [cm] 
set: c2[9.0]              $ lado largo de la placa en plano xy [cm]
set: c3[9.0]              $ lado corto de la placa en plano xy [cm]
set: c8[5.0]              $ Para la visualización.
set: c12[0.50]            $ espesor de la placa de polypropileno [cm]
set: c13[1.00]            $ posicion en z de la placa de polypropileno [cm]
set: c30[500]             $ caja universo [cm]
set: c31[6.94174064]      $ masa molar Li
set: c32[18.9984032]      $ masa molar LiF
set: c9[6.0]


[ S o u r c e ]
 $totfact = 1e6                $flujo total
   s-type =   2                # Rectangular solid and rectangle source
   proj =  proton             # kind of incident particle    
   dir =   1.0                 # z-direction of beam [cosine]
   phi = 0.0
   dom = 0.0     
   x0 = -0.1                   # minimum position of x-axis [cm]
   x1 =  0.1                   # maximum position of x-axis [cm]
   y0 = -0.1                   # minimum position of y-axis [cm]
   y1 =  0.1                   # maximum position of y-axis [cm]
   z0 = -1.0                   # minimum position of z-axis [cm]
   z1 = -0.9                   # maximum position of z-axis [cm]
   e0 = c9                    # energía del proyectil [MeV]

[ M a t e r i a l ]
mat[1]                      $Aire, fracción atómica. Densidad: 1.205e-3 g/cm^3
N 7.84374e-1           
O 2.1076e-1            
Ar 4.6911e-3           
C 1.7579e-4            
            
mat[2]                      $2.71 g/cm3
27Al 1           
            
mat[3]                      $Polipropileno. Densidad: 0.90 g/cm3
C 3
H 6

mat[4]                      $Si natural. Densidad: 2.33 g/cm3
28Si 0.92234
29Si 0.04683
30Si 0.03087

mat[5]                      $Cu natural. Densidad: 8.960 g/cm3
63Cu 0.6917
65Cu 0.3083

mat[6]                      $Pb natural. Densidad: 11.340
208Pb 0.524
207Pb 0.221
206Pb 0.241
204Pb 0.014

mat[7] $Li/LiF Densidad: 0.888 g/cm Densidad Li = 0.534, Densidad LiF =2.635 #6Li 0.02 #7Li 0.98#F 0.5
Li 1+c31/c32
F  c31/c32 

[ Mat Name Color ]
mat name        color
0 Vacio         lightgray
1 Aire          pastelcyan
2 Aluminio      blue
3 Poly          magenta
4 Si            0.267 #darkred#
5 Cu            orange
6 Pb            violet
7 Li/LiF  cyanblue

[ S u r f a c e ]
  10  rpp     -c30 c30 -c30 c30 -c30 c30                                $ borde de la caja que representa el universo xmin , xmax, ymin , ymax , zmin, zmax
  14  rpp     -c2/2 c2/2 -c3/2 c3/2 0. c1                               $ superfie de la placa

[ C e l l ] 
 100   -1  10                                   $ exterior al universo
 101   0 -10 14                                 $ universo donde se propagan las partículas
 102   7 -0.888 -14                             $ película de Li/LiF
 $102   0 -14                                   $ placa de Li/LiF

[ T - P r o d u c t ]
    title = 16 microm de Li/LiF
    part = neutron photon #proton 7Be 7Li 6Li F all
    mesh = reg
    reg  = 102                            #(101 102) da igual que all e igual que 102. Entonces, calcula las partículas producidas en 102.
    volume
    non     reg         vol
     1      102         c2*c3*c1
    material = 1
        7
    #mother = 1
    #    7Li
    #e-type =   2                                       # e-mesh is linear (2: lin, 3:log) given by emin, emax and ne
    #ne =   10                                        # bines
    #emin = 1.0e-4                                       # minimum value of e-mesh points (MeV) 1e-4
    #emax = 500e-3                                       #140e-3  # maximum value of e-mesh points (MeV)
    e-type = 4
    edel = 10e-3                                        # [MeV] 10 keV
    emin = 1.0e-4
    emax = 500e-3
    unit = 4                                            #  [1/cm3/MeV/source]
    axis = eng 
    file = product_eng_3.out
    output = nuclear                                    #particles from nuclear reaction, including elastic 
    gshow =    3            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
    epsout =   2                                       # genera archivo eps con ANGEL con barras de error

[ T - C r o s s ]off
    title = 16 microm de Li/LiF
    mesh =  reg                                        # mesh type is region-wise
    reg =  1                                           # number of crossing regions
    r-from  r-to   area
    102     101    1                                   # hacia el exterior del blanco
    e-type =   2                                       # e-mesh is linear (2: lin, 3:log) given by emin, emax and ne
    ne =   200                                        # bines
    emin =   1e-4                                     # minimum value of e-mesh points (MeV)
    emax =   1e0                                       #140e-3  # maximum value of e-mesh points (MeV)
    part = neutron photon all
    unit =    2                                        # unit is [1/cm2 /MeV/source]
    axis =  eng                                        # axis of output (eng: energy)
    file = blanco_LiLiF_2.output                            # nombre del archivo de salida para 'axis'
    output = current                                   # corriente a través de la superficie. f-curr b-curr
    gshow =    3                                       # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
    epsout =   2                                       # genera archivo eps con ANGEL con barras de error
    bmpout = 1                                         # Bitmap figure of 2D tally output

[ T - T r a c k ]off
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
       nx =  200            # number of x-mesh points
     xmin =   -c8            # minimum value of x-mesh points
     xmax =    c8            # maximum value of x-mesh points
   y-type =    1            # y-mesh is given by the below data
       ny =    1            # number of y-mesh points
           -5.0  5.0
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
       nz =  1000           # number of z-mesh points
     zmin =  -c8           # minimum value of z-mesh points
     zmax =   c8            # maximum value of z-mesh points
   t-type =    2            # t-mesh is linear given by tmin, tmax and nt
       nt =    1            # number of t-mesh points
     tmin =   0.0           # minimum value of t-mesh points
     tmax =   1.0           # maximum value of t-mesh points
     part =  all      
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
            0.0  1000.0
     unit =    1            # unit is [1/cm^2/source]
     axis =   xz            # axis of output
     file = track_xz.out       # file name of output for the above axis
    title = Blanco de Li/LiF 
    gshow =    3            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
   epsout =    1            # (D=0) generate eps file by ANGEL

[ T - T r a c k ]off
     mesh =  xyz            # mesh type is xyz scoring mesh
   y-type =    2            # x-mesh is linear given by xmin, xmax and nx
       ny =  200            # number of x-mesh points
     ymin =   -c8            # minimum value of x-mesh points
     ymax =    c8            # maximum value of x-mesh points
   x-type =    1            # y-mesh is given by the below data
       nx =    1            # number of y-mesh points
           -5.0  5.0
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
       nz =  1000           # number of z-mesh points
     zmin =  -c8           # minimum value of z-mesh points
     zmax =   c8           # maximum value of z-mesh points
   t-type =    2            # t-mesh is linear given by tmin, tmax and nt
       nt =    1            # number of t-mesh points
     tmin =   0.0           # minimum value of t-mesh points
     tmax =   1.0           # maximum value of t-mesh points
     part =  all      
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
            0.0  1000.0
     unit =    1            # unit is [1/cm^2/source]
     axis =   yz            # axis of output
     file = track_yz.out       # file name of output for the above axis
    title = Blanco de Li/LiF 
    gshow =    3            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
   epsout =    1            # (D=0) generate eps file by ANGEL

[ E n d ]