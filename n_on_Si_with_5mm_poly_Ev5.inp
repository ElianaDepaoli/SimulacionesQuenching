$OMP=10
[ T i t l e ]
Sensor de Si de 665 micrómetros de espesor, 1.533 cm x 1.023 cm de area transversal, sobre soporte mecánico de 665 micrómetros de espesor de Si y separados por una capa de SiO2 de 1 micrómetro. El paquete de Cu consta de 3 piezas acumulando 5.36 mm de espesor.
Todo dentro de una cámara de vacío cuadrada de 20 cm de arista de aluminio de 1.1 cm de espesor (para visualizar y para usar algo más realista). Cubo de vacío ideal 9" x 9" x 9"
Frente al detector se encuentra una placa de polipropileno de 5mm de espesor.
Detrás del detector está la chia de Al de 5 cm de espesor, su soporte y la agarradera. 
Fuente circular unidireccional neutrones monoenergéticos. 
Se calcula la energía depositada en Si. 
07/05/26

[ P a r a m e t e r s ]
 icntl    =           0     # (D=0)  8: geometria, 0: interacciones, 5: fuente sin interacciones
 maxcas   =          1e5    # (D=10) numero de particulas por batch
 maxbch   =          1e2    # (D=10) numero de batches
 #file(1)  = /mnt/Data/phits # (D=) nombre de la carpeta donde se encuentra instalado PHITS
 file(1)  = /home/eliana/phits # (D=) nombre de la carpeta donde se encuentra instalado PHITS
 file(6)  = phits_experimento_sin_Poly_cf252.out       # (D=phits.out) general output file name
 negs     =     2
 emin(2)  =     1.0e-11     # (D=1e-3) energía de corte neutron [MeV] esta es la mínima para transporte y generación
 emin(12) =     1.0e-3      # (D=0.1 si negs=1) energía de corte e- [MeV] esta es la mínima para transporte y generación
 emin(13) =     1.0e-3      # (D=0.1 si negs=1) energía de corte e+ [MeV]
 emin(14) =     1.0e-3      # (D=0.001 si negs=1) energía de corte fotones [MeV] mínima para transporte y generación
 dmax(1)  =     20.0        # for JENDL-HE (high-energy nuclear data library)
 dmax(2)  =     20.0        # for JENDL-HE (high-energy nuclear data library)
 dmax(14) =     1e3         # Upper energy limit of atomic library use for photons [MeV]
 
 e-mode   =           2    # D=0 Muestreo simple, D=1 +modelo de evaporación, D=2 +partículas cargadas + distribución de En 
 ikerman  =           1    # (D=0) Kerma approximation for neutrons. D=0,1 it is not used, D=2 it is used.
 ipnint   =           1    # (D=0) 0: no, 1: consider photo-nuclear reaction
 itall    =           1    #  Actualizo resultados al finalizar cada lote (gráficos)
 kmout =              1    # se informa librerías usadas en file(6)
 isaba =              0    # interpolación de los datos de S(alfa,beta) que deberían ser calculados pero no lo son en blancos muy finos 
 ismm  =              1     # "multifragmentación estadística" para calcular la producción más precisa de residuos nucleares
 icxsni  =            0     # 0:Pearlstein-Niita’s formula; 1: KUROTAMA model; 2: Sato’s formula
 icrhi  =             2     # 0:Shen; 1:NASA; 2:KUROTAMA Model options for total cross section of nucleus-nucleus collisions
 icxnp  =             1     # 0: Original database included in JAM; 1: Data included in JENDL/HE-2007
 #istdev   = -1             #  restart calculation mode (para continuar simulacion)

set: c1[0.22]               $ espesor del soporte/paquete de del CCD [cm]
set: c2[11.09]              $ lado largo del soporte/paquete del CCD [cm] en x
set: c3[10.246]             $ lado corto del soporte/paquete del CCD [cm] en y
set: c4[0.500]              $ margen superior soporte/paquete hasta marco [cm] en x
set: c5[1.108]              $ ancho superior marco ventana soporte/paquete del CCD [cm] en x
set: c6[1.762]              $ ancho lateral marco ventana soporte/paquete del CCD [cm] en y
set: c7[7.724]              $ lado corto marco ventana soporte/paquete del CCD [cm] en x
set: c8[8.980]              $ lado largo marco ventana soporte/paquete del CCD [cm] en y
set: c9[5.452]              $ lado corto ventana soporte/paquete del CCD [cm] en x
set: c10[5.454]             $ lado largo ventana soporte/paquete del CCD [cm] en y
set: c11[0.0665]            $ espesor sustrato mecánico Si [cm] $0.015
set: c12[0.0665]            $ espesor del detector en z [cm]
set: c13[0.001]             $ espesor sustrato SiO2 [cm]
set: c14[1.533]             $ lado largo de la cara activa CCD en plano xy, a lo largo del eje x [cm]
set: c15[1.023]             $ lado corto de la cara activa CCD en plano xy, a lo largo del eje y [cm]
set: c16[0.158]             $ espesor placa intermedia/paquete del CCD [cm]
set: c17[10.158]            $ lado largo placa intermedia/paquete del CCD [cm] en y
set: c18[8.570]             $ lado corto placa intermedia/paquete del CCD [cm] en x
set: c19[6.658]             $ largo ventana placa intermedia/paquete del CCD [cm] en x
set: c20[8.864]             $ lado largo tapa/paquete del CCD [cm] en y
set: c21[8.548]             $ lado corto tapa/paquete del CCD [cm] en x

set: c25[5.0e0]             $ espesor soporte chia [cm]
set: c26[11.68]             $ lado corto chia [cm]
set: c27[14.07]             $ lado largo chia [cm]
set: c28[0.2e0]             $ espesor chia [cm]
set: c29[5.71]              $ arista abrazadera

set: c30[9.00]              $ arista de la placa de polypropileno [cm]
set: c31[0.10]              $ espesor de la placa de polypropileno [cm]
set: c32[0.50]              $ posicion en z de la placa de polypropileno [cm] #Original: 1.00
set: c33[2.60]              $ diámetro dedo frío [cm]
set: c34[8.00]              $ largo dedo frío [cm]
set: c40[21.86]             $ semiancho interno del Cubo azul [cm]. Reducir esta para aumentar espesor
set: c41[22.86]             $ semiancho externo del Cubo azul [cm] 
set: c50[500]               $ caja universo [cm]
set: c51[1e0]               $ radio del blanco de Li[cm]

[ S o u r c e ]
 $totfact = 1e6                 $flujo total
   s-type =   1                 # Cylinder or circle source
   proj =  neutron              # kind of incident particle    
   dir =   1.0                  # z-direction of beam [cosine]     
   r0 = c51
   z0 = -c41/2-0.01             # minimum position of z-axis [cm]
   z1 = -c41/2-0.01             # maximum position of z-axis [cm]
   e-type = 1                   # Distribución discreta de energía
   #e-type = 21                 # Distribución continua de energía
   $infl: {n_HISPANOS.inp}[-14]  # Si esta esta linea carga el espectro, sino hay que habilitar e0
   $infl: {cf_252_watt.inp}[-34]
   infl: {n_cf252.inp}[-13] 
   $e0 =   20e-3                # Energia [MeV/nucleon]

[ M a t e r i a l ]
mat[1]                      $Aire, fracción atómica. Densidad: 1.205e-3 g/cm^3
N 7.84374e-1           
O 2.1076e-1            
Ar 4.6911e-3           
C 1.7579e-4            
            
mat[2]                      $2.71 g/cm3
27Al 1           
            
mat[3]                      $Polipropileno. Densidad: 0.90 g/cm3
C 3
H 6

mat[4]                      $Si natural. Densidad: 2.33 g/cm3
28Si 0.92234
29Si 0.04683
30Si 0.03087

mat[5]                      $Cu natural. Densidad: 8.960 g/cm3
63Cu 0.6917
65Cu 0.3083

mat[6]                      $SiO2. Densidad: 2.65 g/cm3
Si 1
O  2

mat[7]                      $Polietileno. Densidad: 0.941 g/cm3 Usé de alta densidad HDPE no sé cuál tiene el experimento.
C 2
H 4

[ Mat Name Color ]
mat name        color
0 Vacio         -0.9#lightgray
1 Aire          {0.600 0.90 1.0}
2 Aluminio      {0.300 1.0 1.0}
3 Poly          yellow#{0.067 1.0 1.0}#
4 Si            {0.002 1.0 1.00}#winered#magenta#{1.0 0.23 1.00}#
5 Cu            0.933#orange
6 SiO2          -0.15 #{0.352 0.0 0.745}#matblack

[ S u r f a c e ]
  10  rpp -c50 c50 -c50 c50 -c50 c50                                       $ universo xmin,xmax,ymin,ymax,zmin,zmax
  11  rpp -c41/2 c41/2 -c41/2 c41/2 -c41/2 c41/2                           $ pared externa del cubo azul
  12  rpp -c40/2 c40/2 -c40/2 c40/2 -c40/2 c40/2                           $ pared interna del cubo azul
  13  rpp -c30/2+c4 c30/2+c4 -c30/2 c30/2 -c32 -c32+c31                    $ placa de polipropileno
  14  rpp  c2/2-c4-c5-c9/2-c14/2 c2/2-c4-c5-c9/2+c14/2 -c15/2 c15/2 c1/2-c11-c13-c12 c1/2-c11-c13            $ detector
  15  rpp -c2/2 c2/2 -c3/2 c3/2 0. c1                                      $ Soporte/Paquete de Cu.
  16  rpp  c2/2-c4-c5-c9 c2/2-c4-c5 -c10/2 c10/2 0.0 c1                     $ Ventana en soporte/paquete Cu 
  17  rpp  c2/2-c4-c7 c2/2-c4 -c10/2-c6 c10/2+c6+0.002 0.0 c1/2             $ Marco ventana en soporte/paquete Cu 
  18  rpp  c2/2-c4-c7 c2/2-c4 -c10/2-c6 c10/2+c6+0.002 c1/2-c11 c1/2        $ soporte mecánico Si en soporte/paquete Cu 
  19  rpp  c2/2-c4-c7 c2/2-c4 -c10/2-c6 c10/2+c6+0.002 c1/2-c11-c13 c1/2-c11 $ sustrato SiO2 entre soporte mecánico y detector
  20  rpp -c18+c2/2 c2/2 -c17/2 c17/2 -c16 0.0                             $ placa intermedia/paquete del CCD
  21  rpp -c19+(c2/2-2*c4) c2/2-2*c4 -c19/2 c19/2 -c16 0.0                 $ hueco de la placa intermedia/paquete del CCD
  22  rpp -c21+c2/2 c2/2 -c20/2 c20/2 -c16*2 -c16                          $ placa intermedia/paquete del CCD

  30  rpp -c27/2 c27/2 -c26/2 c26/2 c12+c1 c12+c1+c28                 $ Chia
  31  REC -5 0.0 c12+c1+c28 0 0.0 1.11 0 7.43/2 0 3.71 0 0            $ soporte chia P(xo,yo,zo) H(x,y,z) A(x,y,z) B(x,y,z)
  32  rpp -5.0 8.0 -8.0 8.0 c12+c1+c28 c12+c1+c28+2.0                 $ soporte chia xmin,xmax,ymin,ymax,zmin,zmax
  33  rpp -5.0-c29 -5.0 -c29/2 c29/2 c12+c1+c28 c12+c1+c28+c29        $ abrazadera 
  34  rcc -5.0 0.0 4.0 -5.0-c29 0.0 0.0 c33/2                         $ hueco para dedo frío

[ C e l l ] 
 100   -1  10                                      $ exterior al universo
 101   0 -10 11 34                                 $ espacio alrededor del cubo azul de aluminio. Vacío.
 102   2 -2.71 -11 12 34                           $ cubo azul de aluminio, 1 cm de espesor
 103   0 -12 #all                                  $ espacio al interior cubo azul descontando poli, detector, chia
 $104   3 -0.90 -13                                $ placa de polipropileno
 104   0 -13                                       $ placa de polipropileno
 105   4 -2.33 -14                                 $ detector de silicio
 106   5 -8.96 -15 14 16 17 18                     $ paquete de Cu, soporte del detector
 107   0 -16 18 14 -17 19                          $ paquete de Cu, ventana del soporte del detector
 108   0 -17 16 18 14 19                           $ paquete de Cu, marco de la ventana del soporte del detector
 109   4 -2.33 -18                                 $ soporte mecánico de Si
 110   5 -8.96 -20 21                              $ paquete de Cu, placa intermedia
 111   0 -21 20 14                                 $ paquete de Cu, hueco placa intermedia
 112   5 -8.96 -22                                 $ paquete de Cu, tapa
 113   6 -2.65 -19                                 $ sustrato SiO2 entre detector y soporte
 120   2 -2.71 -30                                 $ Chia (placa térmica)
 121   2 -2.71 -32 -31                             $ soporte Chia
 122   2 -2.71 -33 34                              $ abrazadera
 123   5 -8.96 -34                                 $ dedo frío

[ T - C r o s s ]off
    title = Source n beam
    mesh =  reg                                        # mesh type is region-wise
    reg =  6                                           # number of crossing regions
    r-from  r-to   area
    101     102    1                                   # de la fuente hacia el vessel 
    102     103    1                                   # hacia el interior del vessel
    103     104    1                                   # hacia la placa de polipropileno
    103     105    1                                   # del vessel al detector
    111     105    1                                   # del hueco de la placa intermedia al detector
    113    105    1                                    # del sustrato al detector
    e-type =   2                                       # e-mesh is linear (2: lin, 3:log) given by emin, emax and ne
    ne =   1000                                        # bines
    emin =   1e-6                                     # minimum value of e-mesh points (MeV)
    emax =   13e0                                     # maximum value of e-mesh points (MeV)
    part = neutron
    unit =    2                                        # unit is [1/cm2 /MeV/source]
    axis =  eng                                        # axis of output (eng: energy)
    file = corriente.output                            # nombre del archivo de salida para 'axis'
    output = current                                   # surface crossing flux
    gshow =    3                                       # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
    epsout =   2                                       # genera archivo eps con ANGEL con barras de error

[ T - Deposit ]
    title = Energy deposition Cf-252, En = [0.0, 13] MeV
    mesh =  reg                                        # mesh type is region mesh
    reg  =  105                                        # region 105 es el detector
    unit =    3                                        # unit is Number [1/source]; only for output=deposit
    material =   all                                   # (D=all) number of specific material
    output =  deposit                                  # total deposit energy
    e-type =   4                                       # e-mesh is linear (2: lin, 3:log) given by emin, emax and ne
    emin = 10e-6                                       # mínimo valor de energía en el intervalo total de cálculo.
    emax = 13e0                                        # máximo valor de energía en el intervalo total de cálculo.
    #ne =   1                                          # cantidad de bines
    edel = 5.0e-2                                      # intervalos de energía
    part =  neutron Si photon electron all    
    axis =    eng                                   # axis of output
    deposit = 1    # 0: total deposit energy with contribution of each type particle 1: deposit energy by each type of particle
    file = deposit_on_Si_sin_Poly_cf252.out      # file name of output for the above axis
    gshow =     3                                   # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
    epsout =    2                                   # (D=0) generate eps file by ANGEL

[T-Interact]off
    #title = Interactions
    file = interactions_on_Si_sin_Poly_sin_Al_HISP.out      # file name of output for the above axis
    MorP = prob                                        # 
    mesh =  reg                                        # mesh type is region mesh
    reg  =  105                                        # region 105 es el detector
    volume
    non reg vol
    1   105 c14*c12*c15                                # volumen de cada region en reg
    part =  neutron   
    material = 1                                       # Calcular en Si
               4
    e-type =   4                                       # e-mesh is linear (2: lin, 3:log) given by emin, emax and ne
    emin = 10e-6                                       # mínimo valor de energía en el intervalo total de cálculo.
    emax = 1.40e-1                                     # máximo valor de energía en el intervalo total de cálculo.
    edel = 1.0e-2
    #ne =   1                                          # cantidad de bines
    unit =    1                                        # 1: [1/cm3/Source] 2: [1/cm3/MeV/Source]
    axis =   act #eng #                                      # number of interaction
    #output = all 
    title = Fuente de Cf-252, 0.0 a 13 MeV
    gshow =     3                                   # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
    epsout =    2                                   # (D=0) generate eps file by ANGEL

[ T - T r a c k ]off
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
       nx =  200            # number of x-mesh points
     xmin =   -6            # minimum value of x-mesh points #17.0
     xmax =    6            # maximum value of x-mesh points #12.5
   y-type =    1            # y-mesh is given by the below data
       ny =    1            # number of y-mesh points
           -0.0  0.0
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
       nz =  1000           # number of z-mesh points
     zmin =  -12.0           # minimum value of z-mesh points #-12.0 $-1.5$
     zmax =  12.0           # maximum value of z-mesh points #12.0 $1.0$
   t-type =    2            # t-mesh is linear given by tmin, tmax and nt
       nt =    1            # number of t-mesh points
     tmin =   0.0           # minimum value of t-mesh points
     tmax =   1.0           # maximum value of t-mesh points
     part =  all      
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
            0.0  1000.0
     unit =    1            # unit is [1/cm^2/source]
     axis =   xz            # axis of output
     file = track_xz5.out       # file name of output for the above axis
    title = Fuente de Cf-252, 0.0 a 13 MeV
    gshow =    3            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
   epsout =    1            # (D=0) generate eps file by ANGEL

[ T - T r a c k ]off
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
       nx =  200            # number of x-mesh points
     xmin =   -15.0            # minimum value of x-mesh points
     xmax =    6.0            # maximum value of x-mesh points
   z-type =    1            # y-mesh is given by the below data
       nz =    1            # number of y-mesh points
           -1.0  7.0
   y-type =    2            # z-mesh is linear given by zmin, zmax and nz
       ny =  1000           # number of z-mesh points
     ymin =   -6.0           # minimum value of z-mesh points
     ymax =    6.0           # maximum value of z-mesh points
   t-type =    2            # t-mesh is linear given by tmin, tmax and nt
       nt =    1            # number of t-mesh points
     tmin =   0.0           # minimum value of t-mesh points
     tmax =   1.0           # maximum value of t-mesh points
     part =  all      
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
            0.0  1000.0
     unit =    1            # unit is [1/cm^2/source]
     axis =   xy            # axis of output
     file = geom_xy4.out       # file name of output for the above axis
    title = n beam source with energies between 20 and 120 keV 
    gshow =    3            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
   epsout =    1            # (D=0) generate eps file by ANGEL


[ T - T r a c k ]off
     mesh =  xyz            # mesh type is xyz scoring mesh
   y-type =    2            # x-mesh is linear given by xmin, xmax and nx
       ny =  200            # number of x-mesh points
     ymin =   -1.5*c41            # minimum value of x-mesh points
     ymax =    1.5*c41            # maximum value of x-mesh points
   x-type =    1            # y-mesh is given by the below data
       nx =    1            # number of y-mesh points
           -5.0  5.0
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
       nz =  1000           # number of z-mesh points
     zmin =  -21           # minimum value of z-mesh points
     zmax =   1.5*c41           # maximum value of z-mesh points
   t-type =    2            # t-mesh is linear given by tmin, tmax and nt
       nt =    1            # number of t-mesh points
     tmin =   0.0           # minimum value of t-mesh points
     tmax =   1.0           # maximum value of t-mesh points
     part =  all      
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
            0.0  1000.0
     unit =    1            # unit is [1/cm^2/source]
     axis =   yz            # axis of output
     file = track_yz.out       # file name of output for the above axis
    title = n beam source with energies between 20 and 120 keV 
